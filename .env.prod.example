# Production Environment Variables
# Copy this file to .env.prod and fill in your actual values
# DO NOT commit .env.prod to git

# Your Digital Ocean Droplet IP or domain name
# Example: http://165.22.123.45  OR  https://tanzeem.yourdomain.com
SERVER_URL=http://YOUR_DROPLET_IP

# Database
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_password_here
DB_NAME=tanzeem_membership

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-key-here
